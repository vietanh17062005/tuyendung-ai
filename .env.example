# Sao chép các giá trị tương ứng từ Settings > Environment Variables của Vercel.
# Để local và deploy dùng chung dữ liệu, phải dùng CÙNG database cloud.
DB_HOST=your-cloud-database-host
DB_PORT=4000
DB_USER=your-database-user
DB_PASSWORD=your-database-password
DB_NAME=your-database-name

# Token của cùng Vercel Blob Store đã kết nối với dự án deploy
BLOB_READ_WRITE_TOKEN=your-vercel-blob-token

# Các biến khác của ứng dụng (AI, email, JWT...) giữ theo cấu hình hiện tại của dự án.
